# Astra — Docker Compose configuration. Copy to .env and edit.
#   cp .env.example .env
# Every value is optional: with none set, the app runs fully (AI falls back to
# the on-device offline reflection). Compose reads this file automatically.

# --- Web ---------------------------------------------------------------------
# Host port the web app is published on — the SAME for dev and prod.
WEB_PORT=5173

# --- Backend environment / security -----------------------------------------
# development boots without a secret. Production REQUIRES a strong AAE_SECRET
# (openssl rand -hex 32) or the backend fails closed and refuses to start.
AAE_ENV=development
AAE_SECRET=

# --- AI provider routing -----------------------------------------------------
# auto = prefer local (kgirl/ollama) → cloud → offline.
AAE_AI_PROVIDER=auto

# Ollama (local models). The backend runs in a container, so "localhost" is the
# container itself — point OLLAMA_HOST at the host gateway to reach an Ollama on
# your machine (extra_hosts maps host.docker.internal in compose). If you run
# Ollama as its own compose service, set this to http://ollama:11434.
OLLAMA_HOST=http://host.docker.internal:11434
AAE_OLLAMA_MODEL=qwen2.5:3b
AAE_OLLAMA_MODEL_DEEP=

# Cloud (any OpenAI-compatible gateway: OpenRouter / OpenAI / Nous).
AAE_AI_API_KEY=
AAE_AI_BASE_URL=https://openrouter.ai/api/v1
AAE_AI_MODEL=anthropic/claude-haiku-4-5

# --- Premium voice (ElevenLabs, optional) -----------------------------------
ELEVENLABS_API_KEY=

# --- Swiss Ephemeris data files (optional) ----------------------------------
# Without these the backend uses the built-in Moshier model. To use .se1 files,
# mount them into the backend container and point SE_EPHE_PATH at the mount.
SE_EPHE_PATH=

# --- Stripe rail (Edition Q only) -------------------------------------------
# ANY AAE_STRIPE_* key marks this deployment public-facing, so the personal-mode
# interlock refuses to boot alongside AAE_PERSONAL_MODE. Test keys may live here;
# LIVE keys belong only in the production host's secret store, never in a repo.
AAE_STRIPE_SECRET_KEY=
AAE_STRIPE_WEBHOOK_SECRET=
# payment = one-time unlock, subscription = monthly. Changes how the offer is
# worded on the pricing surface.
AAE_STRIPE_MODE=subscription
# Founding rates. Prices are read from env per call and the checkout carries an
# inline price, so raising these is an edit + restart — and existing
# subscribers keep the rate they signed up at.
AAE_STRIPE_SUPPORTER_USD=3.25
AAE_STRIPE_ORACLE_USD=9.99
AAE_STRIPE_REPORT_USD=5.50
# Where Stripe redirects back to (must be the PUBLIC origin in production).
AAE_PUBLIC_URL=http://127.0.0.1:5173

# --- Crypto rail / treasury -------------------------------------------------
# Undocumented here until 2026-08-15, and not passed through docker-compose.yml
# either, so setting a wallet used to be a silent no-op. Both are fixed; the
# notes below are the parts that are still easy to get wrong.
#
# The EVM address is NOT display-only. verify_eth_payment_details rejects any
# transaction whose recipient is not this address, so it is simultaneously the
# donate-to address and the verification target. Leave it unset and treasury.py
# falls back to a burn address (0x…dEaD) and /api/pricing reports
# crypto_available=false — which is the correct, closed state.
AAE_TREASURY_ETH=
#
# ⚠️ AAE_ETH_RPC IS WHAT MAKES THE RAIL REAL. Without it the rail fails CLOSED in
# production (trust mode is non-prod only and is pinned empty in compose), so a
# treasury address with no RPC publishes an address that can receive money and
# then mints nothing for it. Set both or neither. Any JSON-RPC endpoint that
# serves eth_getTransactionByHash will do.
AAE_ETH_RPC=
# Minimum accepted payment, in WEI (0 = accept any amount). 1e18 wei = 1 ETH.
AAE_MIN_WEI=
# Oracle tier is minted only for an ON-CHAIN-VERIFIED payment at or above this,
# and only when it is explicitly > 0. Unset means oracle is never minted by the
# crypto rail — fail closed — and trust-mode grants carry value 0, so they can
# never reach it regardless.
AAE_ORACLE_MIN_WEI=
AAE_REPORT_MIN_WEI=
#
# ⚠️ SOL and BTC are DISPLAY ONLY. There is no verifier for them: non-EVM chains
# route to accept_offchain_payment, which grants only under trust mode and so
# always fails closed in production. Publishing one of these addresses invites a
# payment that cannot unlock anything. Set them only if you intend a pure
# donation address with no entitlement attached, and say so in the UI.
AAE_TREASURY_SOL=
AAE_TREASURY_BTC=
AAE_TREASURY_LABEL=
# Funding-dashboard split, must sum to ~100.
AAE_FUNDING_SPLIT=Music:40,Research:30,Agents:30

# --- Entitlement tokens -----------------------------------------------------
# Lifetime of a minted entitlement, in days (default 365).
AAE_ENT_DAYS=
# "hmac" (default, signs with AAE_SECRET) or "ed25519". Ed25519 is what lets a
# device verify a tier OFFLINE against a public key. Verification always accepts
# both when the key material is present, so switching never strands live tokens.
# AAE_ED25519_SEED is 64 hex chars and is REQUIRED when the algo is ed25519 —
# production refuses to boot without it. Generate: tools/gen_ed25519_key.py
AAE_SIGN_ALGO=
AAE_ED25519_SEED=

# --- Cost control + abuse defence -------------------------------------------
# The daily AI spend ceiling. THIS IS THE ONE THAT PROTECTS YOUR BALANCE, and
# the default is deliberately generous ($100/day) because it was written for a
# funded deployment. If you are running on a fixed prepaid budget, set it to
# roughly (what you can afford to lose in a month) / 30 — an unset cap and a
# viral link is how a month's credit disappears in an afternoon.
AAE_GLOBAL_DAILY_USD=3.00
# Per-visitor daily ceiling. Anonymous visitors are bucketed per IP (salted,
# rotated daily, memory-only), so this is what stops ONE person consuming the
# global cap and leaving everybody else on the offline compiler.
AAE_USER_DAILY_USD=0.25
# Warn in the logs at this fraction of the global cap.
AAE_SPEND_ALARM_FRAC=0.80

# Trust forwarding headers (X-Forwarded-For / CF-Connecting-IP)?
# Set to 1 ONLY when the backend cannot be reached except through your proxy —
# in this compose file that is true, because the backend uses `expose:` and is
# never published to the host. Getting it wrong matters in BOTH directions:
#   unset behind a proxy → every visitor looks like the proxy, so the per-IP
#                          rate limit and per-IP budget become ONE shared
#                          bucket for the whole internet.
#   set while directly reachable → anyone can spoof a header and get unlimited
#                          buckets, which is worse, because it looks like it
#                          is working.
AAE_TRUST_PROXY=1
