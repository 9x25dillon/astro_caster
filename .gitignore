# Python
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/
# Every backend env file, not just `.env` exactly. `backend/.env` matched that
# one filename only, so any sibling — .env.public, .env.local, a timestamped
# .env.bak.* taken before editing secrets — was NOT ignored and `git add -A`
# would stage it. Glob first, then re-allow the committed template.
backend/.env*
!backend/.env.example

# Docker Compose env (secrets) — commit .env.example instead
/.env
.env.public
.env.bak.*

# Node / Vite
frontend/node_modules/
frontend/dist/
frontend/dev-dist/
*.local

# Ephemeris data (large binary files, fetched separately)
backend/ephe/
*.se1
# ...except the small asteroid file vendored for the on-device WASM Swiss engine
!packages/astra-core/src/vendor/swisseph/seas_18.se1

# Telemetry database (local instance data, not committed)
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local reports and journals (not source code)
oracle_report_*.txt
course_*.txt
journal/
TASKS.md

# Personal print artifacts (contain birth data) — never commit
*.pdf

# TypeScript incremental build state
*.tsbuildinfo

# Playwright e2e artifacts
frontend/playwright-report/
frontend/test-results/
frontend/e2e/.tokens.json
astra-vault-*.json

# Encrypted server-state backups (contain data/*.db + .env secrets) — the
# file is encrypted, but never track it; ship it to off-box storage
backups/
*.enc

# kgirl — the topological-consensus service ai.py routes to as its
# first-choice provider (KGIRL_URL). It is its OWN git repo
# (github.com/9x25dillon/kgirl) cloned here for convenience, so it must
# never be tracked from this side: committing a nested repo records a
# bare gitlink that looks like a normal directory and silently loses the
# contents. Clone it yourself with:
#   git clone https://github.com/9x25dillon/kgirl.git services/kgirl
services/kgirl/

# Live origin address — public repo, proxied DNS; see DEPLOY.md 3.2
ops/origin.env

# Origin TLS material — private key, never committed (see DEPLOY.md 3.3)
certs/
