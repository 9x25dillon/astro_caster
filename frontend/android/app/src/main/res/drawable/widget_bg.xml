<?xml version="1.0" encoding="utf-8"?>
<!-- The observatory's ground, so the widget reads as part of the app rather
     than as a floating image. Matches the page background the rasteriser
     paints behind the wheel (widgetBridge.ts pageBackground). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0B0B12" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#2A2A3A" />
</shape>
